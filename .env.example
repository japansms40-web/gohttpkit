# gohttpkit 全部环境变量旋钮。
# 变量名 = 前缀 + 后缀；前缀默认 HTTPKIT_，可在 main 最早处 envx.SetPrefix("MYAPP_") 改掉。
# 不设任何变量时全部走代码里的默认值，行为与不引入本文件完全一致。

# ── 日志 ──────────────────────────────────────────────────────────────
# 日志文件路径。一旦设置即落盘（Output 自动推导为 both，stdout 仍保留）
HTTPKIT_LOG_FILE=
# debug / info / warn / error（默认 info）
HTTPKIT_LOG_LEVEL=
# json / console（默认 json）
HTTPKIT_LOG_FORMAT=
# console / file / both（默认 console；设了 LOG_FILE 则为 both）
HTTPKIT_LOG_OUTPUT=

# ── HTTP 重试 ─────────────────────────────────────────────────────────
# 重试上限，默认 3（总尝试 4 次）。代理出口质量差时可调高熬过抖动
HTTPKIT_HTTP_MAX_RETRIES=
# 指数退避基数 ms，默认 200 → 200/400/800
HTTPKIT_HTTP_RETRY_BACKOFF_MS=
# 单次退避封顶 ms，默认 0 = 不封顶
HTTPKIT_HTTP_RETRY_MAX_BACKOFF_MS=

# ── HTTP 超时与告警 ───────────────────────────────────────────────────
# 整请求超时 ms（连接 + 重定向 + 读体全程），默认 30000
HTTPKIT_HTTP_TIMEOUT_MS=
# 响应头超时 ms，默认 15000。设 0 会被视为误配并回落默认（关掉它等于丢失防卡死保护）
HTTPKIT_HTTP_RESPONSE_HEADER_TIMEOUT_MS=
# 慢请求阈值 ms，默认 0 = 关闭。超阈值的 http_transaction 日志降级为 warn 并标 slow=true
HTTPKIT_HTTP_SLOW_MS=
