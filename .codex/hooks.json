{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/scripts/agent-guard.sh\" hook --agent codex --event pre-tool'",
            "timeout": 60,
            "statusMessage": "agentguard 前置检查"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/scripts/agent-guard.sh\" hook --agent codex --event post-tool'",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/scripts/agent-guard.sh\" hook --agent codex --event stop'",
            "timeout": 360,
            "statusMessage": "agentguard 收尾检查（治理守卫 + make check）"
          }
        ]
      }
    ]
  }
}
